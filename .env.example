# Vorlage für die Konfiguration. Kopieren nach .env und Werte eintragen.
# Niemals echte Secrets, Domains oder IPs in dieses Repo committen.

TZ=Europe/Berlin
# Port der App im LAN (Host-Seite)
APP_PORT=8470

# Subnetze/IPs, aus denen direkter Zugriff ohne Cloudflare erlaubt ist (Tablet), kommagetrennt
LAN_SUBNETS=192.0.2.0/24

# --- Öffentlicher Zugang über Cloudflare Tunnel + Access ---
PUBLIC_HOST=dashboard.example.com
# IP(s), von denen cloudflared die App erreicht. Diese gelten nie als LAN.
TUNNEL_SOURCE_IPS=192.0.2.20
# Team-Domain aus Zero Trust (Settings → Custom Pages bzw. Team name)
CF_ACCESS_TEAM_DOMAIN=https://example-team.cloudflareaccess.com
# "Application Audience (AUD) Tag" der Access-Application
CF_ACCESS_AUD=

# Session-Dauer: Tablet (LAN) in Minuten, Handy (öffentlich) in Tagen
SESSION_TTL_LAN_MIN=10
SESSION_TTL_PUBLIC_DAYS=90

# --- Google Calendar (Anleitung: docs/google-setup.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 Byte base64: openssl rand -base64 32 – verschlüsselt die Google-Tokens. Nie ändern, sicher aufbewahren!
ENCRYPTION_KEY=
# Abgleich-Intervall in Minuten
CALENDAR_SYNC_MIN=3

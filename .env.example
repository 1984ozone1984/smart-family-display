# Vorlage für die Konfiguration. Kopieren nach .env und Werte eintragen.
# Niemals echte Secrets, Domains oder IPs in dieses Repo committen.

# Öffentliche Domain hinter Cloudflare Access (ab Phase 1)
PUBLIC_HOST=dashboard.example.com
# LAN-Adresse des Servers, über die das Tablet zugreift
LAN_HOST=192.0.2.10

# Weitere Werte folgen ab Phase 1 (DB, Secrets, Google OAuth, Mealie).
